 "intent": {
  "request": "Une tontine digitale pour le Cameroun : bureau traditionnel à cinq rôles, cotisations et décaissements par Mobile Money, compte séquestre, attribution du pot aux enchères, pénalités de retard et redistribution des intérêts en fin de cycle.",
  "requestLocale": "fr",
  "needs": [
   {
    "id": "need_bureau",
    "statement": "Reproduire le bureau traditionnel — Président, Secrétaire, Trésorier, Censeur, Membre — par une matrice d'accès stricte.",
    "resolution": {
     "kind": "satisfied",
     "nodeIds": [
      "role_president",
      "role_secretaire",
      "role_tresorier",
      "role_censeur",
      "role_membre",
      "right_bureau",
      "right_registre",
      "right_tresorerie",
      "right_discipline",
      "right_encaisser_cash"
     ]
    }
   },
   {
    "id": "need_membre_sans_telephone",
    "statement": "Un membre peut n'avoir ni smartphone ni compte Mobile Money, et reste rattaché à un mandataire.",
    "resolution": {
     "kind": "satisfied",
     "nodeIds": [
      "ent_utilisateurs",
      "fld_utilisateurs_est_sans_telephone",
      "fld_utilisateurs_mandataire",
      "rel_mandat"
     ]
    }
   },
   {
    "id": "need_registre",
    "statement": "Tenir le registre des membres d'une tontine, leur rôle, leur ordre de passage et leur cumul d'amendes.",
    "resolution": {
     "kind": "satisfied",
     "nodeIds": [
      "ent_membres_tontine",
      "scr_membres",
      "scr_annuaire"
     ]
    }
   },
   {
    "id": "need_tontines",
    "statement": "Une tontine porte son montant de cotisation, sa fréquence, son taux de pénalité et son statut.",
    "resolution": {
     "kind": "satisfied",
     "nodeIds": [
      "ent_tontines",
      "fld_tontines_montant_cotisation",
      "fld_tontines_frequence",
      "fld_tontines_statut"
     ]
    }
   },
   {
    "id": "need_journal_transactions",
    "statement": "Chaque mouvement est horodaté, typé, et garde la trace de son opérateur et de sa référence externe.",
    "resolution": {
     "kind": "satisfied",
     "nodeIds": [
      "ent_transactions",
      "fld_transactions_type_op",
      "fld_transactions_operateur",
      "fld_transactions_reference_externe",
      "scr_transactions"
     ]
    }
   },
   {
    "id": "need_kyc",
    "statement": "Vérification d'identité obligatoire : pièce d'identité et selfie, contrôlés par le bureau.",
    "resolution": {
     "kind": "satisfied",
     "nodeIds": [
      "fld_utilisateurs_piece_identite",
      "fld_utilisateurs_photo_profil",
      "fld_utilisateurs_est_president_verifie",
      "scr_verification",
      "right_bureau"
     ]
    }
   },
   {
    "id": "need_tableau_membre",
    "statement": "Un membre consulte sa position et son historique financier sans aucune charge du bureau.",
    "resolution": {
     "kind": "satisfied",
     "nodeIds": [
      "scr_mon_tableau",
      "role_membre"
     ]
    }
   },
   {
    "id": "need_mandat_agir_pour",
    "statement": "Le mandataire AGIT AU NOM d'un autre : il cotise pour lui et encaisse son pot.",
    "resolution": {
     "kind": "satisfied",
     "nodeIds": [
      "right_encaisser_cash",
      "ent_utilisateurs",
      "fld_utilisateurs_mandataire",
      "fld_utilisateurs_est_sans_telephone",
      "rel_mandat",
      "scr_encaissement"
     ]
    }
   },
   {
    "id": "need_sequestre",
    "statement": "Les fonds collectés sont bloqués sur un compte séquestre jusqu'à l'échéance du tour.",
    "resolution": {
     "kind": "unexpressible",
     "reason": "L'ORDRE des états est maintenant déclaré (`transitions`) : le séquestre ne se dé-bloque plus vers un état antérieur. Mais l'ÉCHÉANCE ne l'est pas. « Jusqu'à l'échéance du tour » suppose une HORLOGE qui fasse passer l'état toute seule, et une horloge vit sur le serveur. Le format dit ce qui est PERMIS, jamais ce qui arrive de soi-même — prétendre le contraire ferait croire qu'une application déverrouille des fonds sans que personne n'agisse."
    }
   },
   {
    "id": "need_encheres",
    "statement": "Le pot est attribué par enchère : le membre qui propose la plus forte prime l'emporte.",
    "resolution": {
     "kind": "unexpressible",
     "reason": "Une enchère est une CONCURRENCE entre plusieurs membres sur un même objet, avec un gagnant et une clôture. Le format décrit des écrans, des listes et des gestes individuels ; il n'a aucun nœud pour un mécanisme où le geste d'un membre invalide celui d'un autre."
    }
   },
   {
    "id": "need_penalites",
    "statement": "Les pénalités de retard valent 2 % par jour et se répartissent 70 % au groupe, 30 % à la plateforme.",
    "resolution": {
     "kind": "unexpressible",
     "reason": "Calcul sur une DURÉE, puis partage. Le format ne porte ni l'un ni l'autre : `rules.kind = \"validation\"` sait refuser une saisie, jamais produire un montant. C'est la même famille que le stock calculé de SGD, resté inexprimable."
    }
   },
   {
    "id": "need_cagnotte",
    "statement": "Les primes d'enchères s'accumulent pendant tout le cycle, puis se répartissent à parts égales en fin de cycle.",
    "resolution": {
     "kind": "unexpressible",
     "reason": "Deux manques en un : l'ACCUMULATION (un champ qui est la somme d'autres lignes) et l'ÉVÉNEMENT DE FIN DE CYCLE. Le déclencheur `lifecycle` connaît l'ouverture d'un écran, pas l'achèvement d'un cycle métier."
    }
   },
   {
    "id": "need_mobile_money",
    "statement": "Collecte et décaissement par les API Orange Money Cameroun et MTN Mobile Money.",
    "resolution": {
     "kind": "unexpressible",
     "reason": "Le registre des capacités porte `payments.psp` (Stripe) et `payments.offapp_transfer`, qui dit explicitement « aucun opérateur intégré, aucun appel réseau ». Aucun opérateur d'argent mobile africain n'y figure, alors que c'est l'infrastructure de paiement du marché visé."
    }
   },
   {
    "id": "need_otp_payout",
    "statement": "Un décaissement n'est exécuté qu'après saisie d'un code à 6 chiffres reçu par WhatsApp ou SMS.",
    "resolution": {
     "kind": "unexpressible",
     "reason": "Une validation en DEUX TEMPS, avec un secret envoyé par un canal tiers. Le format décrit un geste et son effet ; il n'a pas de nœud pour un geste SUSPENDU à une confirmation hors application."
    }
   },
   {
    "id": "need_tour_courant",
    "statement": "À chaque séance, un membre et un seul encaisse le pot, selon l'ordre de passage.",
    "resolution": {
     "kind": "unexpressible",
     "reason": "`ordre_passage` est un nombre sur une ligne. Rien ne dit QUEL tour est en cours, ni que le tour avance quand le pot est versé. L'état d'avancement d'un cycle n'a pas de place au format."
    }
   },
   {
    "id": "need_categorie_financiere",
    "statement": "Déclarer aux magasins que l'application traite des données financières.",
    "resolution": {
     "kind": "unexpressible",
     "reason": "`compliance.dataCollected` est une énumération FERMÉE de sept catégories, et aucune ne couvre l'argent : contact_info, identifiers, usage_data, location, user_content, purchases, diagnostics. Or Apple ET Google portent une catégorie « Financial Info » dans leurs étiquettes de confidentialité. Déclarer `purchases` serait inexact — dans une tontine, personne n'achète rien : les membres se prêtent de l'argent. Une déclaration fausse à un magasin est pire qu'une déclaration incomplète."
    }
   },
   {
    "id": "need_export_pdf",
    "statement": "Le Secrétaire exporte les procès-verbaux et les rapports en PDF d'un seul clic.",
    "resolution": {
     "kind": "unexpressible",
     "reason": "Aucune capacité du registre ne produit de document. `share` partage ce qui existe déjà ; rien ne fabrique un PDF à partir des données."
    }
   }
  ]
 }
}