 "intent": {
  "request": "Un système de gestion pour un commerce : stock par lieu, mouvements, conteneurs, ventes, charges et rentabilité, avec des droits par employé.",
  "requestLocale": "fr",
  "needs": [
   {
    "id": "need_articles",
    "statement": "Tenir un catalogue d'articles avec référence, nom, prix de vente et famille.",
    "resolution": {
     "kind": "satisfied",
     "nodeIds": [
      "ent_articles",
      "scr_recherche"
     ]
    }
   },
   {
    "id": "need_lieux",
    "statement": "Plusieurs lieux de stockage : magasins et dépôts.",
    "resolution": {
     "kind": "satisfied",
     "nodeIds": [
      "ent_lieux",
      "scr_lieux"
     ]
    }
   },
   {
    "id": "need_emplacement",
    "statement": "L'endroit où ranger une pièce dépend du lieu : « rayon 3 » au magasin n'est pas « rayon 3 » au dépôt.",
    "resolution": {
     "kind": "satisfied",
     "nodeIds": [
      "ent_emplacements"
     ]
    }
   },
   {
    "id": "need_prix_absent",
    "statement": "Un prix non renseigné n'est pas un prix de zéro : l'écran doit pouvoir le dire.",
    "resolution": {
     "kind": "satisfied",
     "nodeIds": [
      "ent_articles"
     ]
    }
   },
   {
    "id": "need_journal_recherche",
    "statement": "Enregistrer les recherches qui ne trouvent rien, sans jamais noter QUI a cherché.",
    "resolution": {
     "kind": "satisfied",
     "nodeIds": [
      "ent_recherches_ratees"
     ]
    }
