  "app": {
    "name": "Kôrô Artisans",
    "slug": "koro-artisans",
    "description": [
      {
        "locale": "fr",
        "text": "La marketplace des artisans de Côte d'Ivoire : bijoux, tissus, mobilier et déco de plusieurs vendeurs. Parcourez les produits par catégorie avec photos et prix, recherchez, consultez la fiche d'un produit et son vendeur, ajoutez au panier, payez par carte et suivez vos commandes."
      }
    ],
