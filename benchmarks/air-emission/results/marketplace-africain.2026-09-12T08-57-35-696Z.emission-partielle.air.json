{
  "airSchemaVersion": "1.22.0",
  "projectId": "prj_marche_sahel",
  "app": {
    "name": "Marché Sahel",
    "slug": "marche-sahel",
    "description": [
      {
        "locale": "fr",
        "text": "Place de marché du Tchad et du Sahel : les vendeurs ouvrent leur boutique et publient leurs produits avec photos et prix en francs CFA, les acheteurs parcourent le catalogue par catégorie, recherchent un produit et contactent le vendeur directement par WhatsApp ou par téléphone. Aucun paiement en ligne entre acheteur et vendeur ; les vendeurs paient la plateforme pour mettre leurs produits en avant."
      }
    ],
    "locales": {
      "userLanguage": "fr",
      "appLocales": [
        "fr"
      ],
      "defaultAppLocale": "fr",
      "contentLocales": [
        "fr"
      ],
      "rtlSupported": false
    }
  },
