  "rules": [
    {
      "id": "rule_produit_publication_valide",
      "description": "Un produit publié porte obligatoirement un nom, une photo, un prix en francs CFA strictement positif et un état de publication connu.",
      "kind": "validation",
      "entityId": "ent_produit",
      "assertions": [
        {
          "fieldId": "fld_produit_titre",
          "operator": "required"
        },
        {
          "fieldId": "fld_produit_photo",
          "operator": "required"
        },
        {
          "fieldId": "fld_produit_prix",
          "operator": "gt",
          "value": 0
        },
        {
          "fieldId": "fld_produit_statut",
          "operator": "in",
          "value": [
            "publie",
            "retire"
          ]
        }
      ]
    },
    {
      "id": "rule_produit_rattachement",
      "description": "Un produit indique sa ville de vente, sa boutique vendeuse et sa catégorie de catalogue.",
      "kind": "validation",
      "entityId": "ent_produit",
      "assertions": [
        {
          "fieldId": "fld_produit_ville",
          "operator": "required"
        },
        {
          "fieldId": "fld_produit_boutique",
          "operator": "required"
        },
        {
          "fieldId": "fld_produit_categorie",
          "operator": "required"
        }
      ]
    },
    {
      "id": "rule_boutique_joignable",
      "description": "Une boutique déclare son nom, sa ville et un numéro de téléphone joignable au format international du Sahel.",
      "kind": "validation",
      "entityId": "ent_boutique",
      "assertions": [
        {
          "fieldId": "fld_boutique_nom",
          "operator": "required"
        },
        {
          "fieldId": "fld_boutique_ville",
          "operator": "required"
        },
        {
          "fieldId": "fld_boutique_telephone",
          "operator": "matches",
          "value": "^\\+?[0-9][0-9 ]{7,19}$"
        },
        {
          "fieldId": "fld_boutique_statut",
          "operator": "in",
          "value": [
            "ouverte",
            "fermee"
          ]
        }
      ]
    },
    {
      "id": "rule_boutique_ouverte_pour_publier",
      "description": "Seule une boutique à l'état ouverte peut publier et mettre en avant des produits dans le catalogue.",
      "kind": "authorization",
      "entityId": "ent_boutique",
      "assertions": [
        {
          "fieldId": "fld_boutique_statut",
          "operator": "eq",
          "value": "ouverte"
        }
      ]
    },
    {
      "id": "rule_prise_contact_complete",
      "description": "Une prise de contact précise le canal choisi (WhatsApp ou appel), le message, le nom et le numéro de l'acheteur ainsi que le produit concerné.",
      "kind": "validation",
      "entityId": "ent_prise_contact",
      "assertions": [
        {
          "fieldId": "fld_prise_contact_canal",
          "operator": "in",
          "value": [
            "whatsapp",
            "appel"
          ]
        },
        {
          "fieldId": "fld_prise_contact_message",
          "operator": "required"
        },
        {
          "fieldId": "fld_prise_contact_acheteur_nom",
          "operator": "required"
        },
        {
          "fieldId": "fld_prise_contact_acheteur_telephone",
          "operator": "matches",
          "value": "^\\+?[0-9][0-9 ]{7,19}$"
        },
        {
          "fieldId": "fld_prise_contact_produit",
          "operator": "required"
        }
      ]
    },
    {
      "id": "rule_mise_en_avant_valide",
      "description": "Une mise en avant désigne un produit, une formule, une période et un montant en francs CFA strictement positif payé par le vendeur à la plateforme.",
      "kind": "validation",
      "entityId": "ent_mise_en_avant",
      "assertions": [
        {
          "fieldId": "fld_mise_en_avant_produit",
          "operator": "required"
        },
        {
          "fieldId": "fld_mise_en_avant_intitule",
          "operator": "required"
        },
        {
          "fieldId": "fld_mise_en_avant_date_debut",
          "operator": "required"
        },
        {
          "fieldId": "fld_mise_en_avant_date_fin",
          "operator": "required"
        },
        {
          "fieldId": "fld_mise_en_avant_montant",
          "operator": "gt",
          "value": 0
        },
        {
          "fieldId": "fld_mise_en_avant_statut",
          "operator": "in",
          "value": [
            "a_regler",
            "active",
            "expiree"
          ]
        }
      ]
    }
  ],
  "slots": [
    {
      "id": "slot_selection_mise_en_avant",
      "description": "Classe les produits du catalogue en plaçant d'abord ceux dont une mise en avant payée est active à la date du jour, puis les plus récents, et produit le libellé de la section vedette de l'accueil (par exemple « 6 produits mis en avant cette semaine »).",
