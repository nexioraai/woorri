  "rules": [
    {
      "id": "rule_soin_fiche_complete",
      "description": "Un soin publié au catalogue porte obligatoirement un nom, une catégorie, une photo et une durée strictement positive.",
      "kind": "validation",
      "entityId": "ent_soin",
      "assertions": [
        {
          "fieldId": "fld_soin_nom",
          "operator": "required"
        },
        {
          "fieldId": "fld_soin_categorie",
          "operator": "required"
        },
        {
          "fieldId": "fld_soin_photo",
          "operator": "required"
        },
        {
          "fieldId": "fld_soin_duree",
          "operator": "gt",
          "value": 0
        }
      ]
    },
    {
      "id": "rule_soin_categorie_connue",
      "description": "La catégorie d'un soin appartient aux familles proposées par l'institut : massages, soins du visage, manucure, hammam.",
      "kind": "validation",
      "entityId": "ent_soin",
      "assertions": [
        {
          "fieldId": "fld_soin_categorie",
          "operator": "in",
          "value": [
            "Massages",
            "Soins du visage",
            "Manucure",
            "Hammam"
          ]
        }
      ]
    },
    {
      "id": "rule_creneau_reservable",
      "description": "Un créneau ne peut être choisi que s'il porte une plage horaire, un soin rattaché et qu'il est encore disponible.",
      "kind": "validation",
      "entityId": "ent_creneau",
      "assertions": [
        {
          "fieldId": "fld_creneau_plage",
          "operator": "required"
        },
        {
          "fieldId": "fld_creneau_soin",
          "operator": "required"
        },
        {
          "fieldId": "fld_creneau_disponible",
          "operator": "eq",
          "value": true
        }
      ]
    },
    {
      "id": "rule_creneau_plage_renseignee",
      "description": "La plage horaire affichée à la cliente respecte le format « 09:00 – 10:00 ».",
      "kind": "validation",
      "entityId": "ent_creneau",
      "assertions": [
        {
          "fieldId": "fld_creneau_plage",
          "operator": "matches",
          "value": "^[0-2][0-9]:[0-5][0-9] – [0-2][0-9]:[0-5][0-9]$"
        }
      ]
    }
  ],
