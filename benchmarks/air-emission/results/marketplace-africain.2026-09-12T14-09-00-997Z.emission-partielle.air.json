  "app": {
    "name": "Souk Sahel",
    "slug": "souk-sahel",
    "description": [
      {
        "locale": "fr",
        "text": "Place de marché du Tchad et du Sahel : les vendeurs publient leurs produits avec photos et prix en francs CFA, les acheteurs parcourent le catalogue par catégorie, recherchent un produit et contactent directement le vendeur par WhatsApp ou par téléphone. Les vendeurs paient la plateforme pour mettre leurs produits en avant."
      }
    ],
    "locales": {
      "userLanguage": "fr",
      "appLocales": [
        "fr"
      ],
      "defaultAppLocale": "fr",
      "contentLocales": [
        "fr"
      ],
      "rtlSupported": false
    }
  },
