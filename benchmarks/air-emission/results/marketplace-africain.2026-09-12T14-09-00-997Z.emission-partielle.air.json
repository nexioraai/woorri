  "rules": [
    {
      "id": "rule_produit_publication_complete",
      "description": "Un produit ne peut être publié que s'il porte un nom, une photo et un prix en francs CFA.",
      "kind": "validation",
      "entityId": "ent_produit",
      "assertions": [
        {
          "fieldId": "fld_produit_nom",
          "operator": "required"
        },
        {
          "fieldId": "fld_produit_photo",
          "operator": "required"
        },
        {
          "fieldId": "fld_produit_prix",
          "operator": "required"
        }
      ]
    },
    {
      "id": "rule_produit_prix_positif",
      "description": "Le prix affiché en FCFA doit être strictement supérieur à zéro et rester sous le plafond d'annonce de 50 000 000 FCFA.",
      "kind": "validation",
      "entityId": "ent_produit",
      "assertions": [
        {
          "fieldId": "fld_produit_prix",
          "operator": "gt",
          "value": 0
        },
        {
          "fieldId": "fld_produit_prix",
          "operator": "lte",
          "value": 50000000
        }
      ]
    },
    {
      "id": "rule_boutique_identite_complete",
      "description": "Une boutique doit indiquer son nom et sa ville avant de publier des produits au catalogue.",
      "kind": "validation",
      "entityId": "ent_boutique",
      "assertions": [
        {
          "fieldId": "fld_boutique_nom",
          "operator": "required"
        },
        {
          "fieldId": "fld_boutique_ville",
          "operator": "required"
        }
      ]
    },
    {
      "id": "rule_boutique_contact_joignable",
      "description": "Comme l'échange se fait hors application, la boutique doit fournir un numéro de téléphone au format international (+235, +227, +223…).",
      "kind": "validation",
      "entityId": "ent_boutique",
      "assertions": [
        {
          "fieldId": "fld_boutique_telephone",
          "operator": "required"
        },
        {
          "fieldId": "fld_boutique_telephone",
          "operator": "matches",
          "value": "^\\+[0-9][0-9 ]{7,18}$"
        }
      ]
    },
    {
      "id": "rule_boutique_whatsapp_format",
      "description": "Le numéro WhatsApp, lorsqu'il est renseigné, doit être au format international pour permettre l'ouverture de la conversation.",
      "kind": "validation",
      "entityId": "ent_boutique",
      "assertions": [
        {
          "fieldId": "fld_boutique_whatsapp",
          "operator": "matches",
          "value": "^\\+[0-9][0-9 ]{7,18}$"
        }
      ]
    },
    {
      "id": "rule_boutique_ville_couverte",
      "description": "La boutique déclare une ville desservie par la place de marché du Tchad et du Sahel.",
      "kind": "validation",
      "entityId": "ent_boutique",
      "assertions": [
        {
          "fieldId": "fld_boutique_ville",
          "operator": "in",
          "value": [
            "N'Djamena",
            "Moundou",
            "Abéché",
            "Sarh",
            "Faya-Largeau",
            "Bongor",
            "Doba",
            "Niamey",
            "Bamako",
            "Maroua",
            "Ouagadougou",
            "Nouakchott"
          ]
        }
      ]
    },
    {
      "id": "rule_categorie_nom_unique",
      "description": "Chaque catégorie du catalogue porte un nom lisible et non vide.",
      "kind": "validation",
      "entityId": "ent_categorie",
      "assertions": [
        {
          "fieldId": "fld_categorie_nom",
          "operator": "required"
        }
      ]
    },
    {
      "id": "rule_produit_modification_reservee_vendeur",
      "description": "Seule la boutique propriétaire du produit peut le modifier ou le retirer du catalogue.",
      "kind": "authorization",
      "entityId": "ent_produit",
      "assertions": [
        {
          "fieldId": "fld_produit_nom",
          "operator": "required"
        }
      ]
    },
    {
      "id": "rule_boutique_edition_reservee_proprietaire",
      "description": "Seul le vendeur connecté propriétaire de la boutique peut en éditer la fiche et les coordonnées de contact.",
      "kind": "authorization",
      "entityId": "ent_boutique",
      "assertions": [
        {
          "fieldId": "fld_boutique_nom",
          "operator": "required"
        }
      ]
    }
  ],
  "slots": [
    {
      "id": "slot_prix_fcfa_lisible",
      "description": "Met en forme le prix d'un produit en francs CFA avec séparateurs de milliers (145 000 FCFA) et renvoie le libellé prêt à afficher sur la fiche produit.",
      "inputs": [
        {
          "name": "produits",
          "type": "json"
        },
        {
          "name": "devise",
          "type": "string"
        }
      ],
      "outputs": [
        {
          "name": "prixLisible",
          "type": "string"
        },
        {
          "name": "prixDetail",
          "type": "text"
        }
      ],
      "allowedImports": []
    },
    {
      "id": "slot_catalogue_mise_en_avant",
      "description": "Classe les produits du catalogue en plaçant en tête ceux dont la boutique a payé une mise en avant, et produit le titre de la section 'Sélection mise en avant' ainsi que son message d'absence.",
      "inputs": [
        {
          "name": "produits",
          "type": "json"
        },
        {
          "name": "limite",
          "type": "number"
        }
      ],
      "outputs": [
        {
          "name": "titreSelection",
          "type": "string"
        },
        {
          "name": "messageVide",
          "type": "text"
        }
      ],
      "allowedImports": []
    },
