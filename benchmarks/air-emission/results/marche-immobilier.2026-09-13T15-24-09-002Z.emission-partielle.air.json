  "rules": [
    {
      "id": "rule_ville_identite",
      "description": "Une ville publiée porte toujours un nom et le pays auquel elle appartient.",
      "kind": "validation",
      "entityId": "ent_ville",
      "assertions": [
        {
          "fieldId": "fld_ville_nom",
          "operator": "required"
        },
        {
          "fieldId": "fld_ville_pays",
          "operator": "required"
        }
      ]
    },
    {
      "id": "rule_quartier_rattachement",
      "description": "Un quartier porte un nom et se rattache obligatoirement à une ville du marché.",
      "kind": "validation",
      "entityId": "ent_quartier",
      "assertions": [
        {
          "fieldId": "fld_quartier_nom",
          "operator": "required"
        },
        {
          "fieldId": "fld_quartier_ville",
          "operator": "required"
        }
      ]
    },
    {
      "id": "rule_vendeur_contact_joignable",
      "description": "Un annonceur doit être joignable : nom et numéro de téléphone d'appel obligatoires, puisque toute visite s'organise par contact direct.",
      "kind": "validation",
      "entityId": "ent_vendeur",
      "assertions": [
        {
          "fieldId": "fld_vendeur_nom",
          "operator": "required"
        },
        {
          "fieldId": "fld_vendeur_telephone",
          "operator": "required"
        },
        {
          "fieldId": "fld_vendeur_telephone",
          "operator": "matches",
          "value": "^\\+?[0-9 ]{8,20}$"
        }
      ]
    },
    {
      "id": "rule_vendeur_type_connu",
      "description": "Un annonceur est soit une agence immobilière, soit un particulier.",
      "kind": "validation",
      "entityId": "ent_vendeur",
      "assertions": [
        {
          "fieldId": "fld_vendeur_type",
          "operator": "required"
        },
        {
          "fieldId": "fld_vendeur_type",
          "operator": "in",
          "value": [
            "agence",
            "particulier"
          ]
        }
      ]
    },
    {
      "id": "rule_vendeur_compte",
      "description": "Le compte annonceur exige une adresse e-mail valide et un mot de passe pour s'identifier.",
      "kind": "validation",
      "entityId": "ent_vendeur",
      "assertions": [
        {
          "fieldId": "fld_vendeur_email",
          "operator": "required"
        },
        {
          "fieldId": "fld_vendeur_email",
          "operator": "matches",
          "value": "^[^@\\s]+@[^@\\s]+\\.[a-z]{2,}$"
        },
        {
          "fieldId": "fld_vendeur_mot_de_passe",
          "operator": "required"
        }
      ]
    }
  ],
  "slots": [
    {
      "id": "slot_contact_vendeur_liens",
      "description": "Construit, à partir des coordonnées de l'annonceur, le libellé d'appel téléphonique et le libellé WhatsApp affichés sur l'écran de contact (numéro normalisé au format international sahélien, mention d'absence de WhatsApp si le numéro est vide).",
      "inputs": [
        {
          "name": "vendeurRows",
          "type": "json"
        }
      ],
      "outputs": [
        {
          "name": "libelleAppel",
          "type": "string"
        },
        {
          "name": "libelleWhatsapp",
          "type": "string"
        }
      ],
      "allowedImports": []
    },
    {
      "id": "slot_quartiers_par_ville",
      "description": "Résume pour chaque ville le nombre de quartiers couverts et en produit une phrase de contexte affichée sous l'en-tête de l'écran Villes.",
      "inputs": [
        {
          "name": "villeRows",
          "type": "json"
        },
        {
          "name": "quartierRows",
          "type": "json"
        }
      ],
      "outputs": [
        {
          "name": "resumeCouverture",
          "type": "string"
        }
      ],
      "allowedImports": []
    }
  ],
