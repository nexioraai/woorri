  "app": {
    "name": "Sahel Immo",
    "slug": "sahel-immo",
    "description": [
      {
        "locale": "fr",
        "text": "Le marché immobilier du Tchad et du Sahel : agences et particuliers publient leurs biens à vendre ou à louer avec photos, prix en francs CFA, surface, nombre de pièces et quartier. Les acheteurs et locataires parcourent les annonces, filtrent par ville, quartier, prix et type de bien, consultent la fiche complète et contactent directement le vendeur pour organiser une visite."
      }
    ],
