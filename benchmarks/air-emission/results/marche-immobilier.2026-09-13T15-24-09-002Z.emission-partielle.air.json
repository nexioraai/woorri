  "permissions": [
    {
      "platform": "ios",
      "permission": "NSPhotoLibraryUsageDescription",
      "reason": [
        {
          "locale": "fr",
          "text": "Sahel Immo accède à vos photos pour que vous puissiez joindre les images de votre bien (maison, villa, terrain) à votre annonce."
        }
      ],
      "requiredByCapability": "media_upload"
    },
    {
      "platform": "android",
      "permission": "android.permission.READ_MEDIA_IMAGES",
      "reason": [
        {
          "locale": "fr",
          "text": "Sahel Immo lit les images de votre appareil pour illustrer l'annonce de votre bien avec vos propres photos."
        }
      ],
