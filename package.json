{
  "name": "deribfy",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=nexiora-ai",
    "build": "npm run build --workspace=nexiora-ai",
    "start": "npm run start --workspace=nexiora-ai",
    "test": "npm run test --workspace=nexiora-ai",
    "lint": "npm run lint --workspace=nexiora-ai",
    "check:api-docs": "npm run check:api-docs --workspace=nexiora-ai",
    "packages:typecheck": "npm run typecheck --workspace=@deribfy/air-schema --workspace=@deribfy/capability-registry --workspace=@deribfy/golden-corpus --workspace=@deribfy/design-tokens --workspace=@deribfy/primitives --workspace=@deribfy/primitives-web --workspace=@deribfy/blocks --workspace=@deribfy/compiler --workspace=@deribfy/provisioner --workspace=@deribfy/sandbox --workspace=@deribfy/oracle --workspace=@deribfy/workflow --workspace=@deribfy/slots --workspace=@deribfy/repair --workspace=@deribfy/provider-registry --workspace=@deribfy/execution-contract --workspace=@deribfy/fidelity --workspace=@deribfy/router",
    "packages:lint": "npm run lint --workspace=@deribfy/air-schema --workspace=@deribfy/capability-registry --workspace=@deribfy/golden-corpus --workspace=@deribfy/design-tokens --workspace=@deribfy/primitives --workspace=@deribfy/primitives-web --workspace=@deribfy/blocks --workspace=@deribfy/compiler --workspace=@deribfy/provisioner --workspace=@deribfy/sandbox --workspace=@deribfy/oracle --workspace=@deribfy/workflow --workspace=@deribfy/slots --workspace=@deribfy/repair --workspace=@deribfy/provider-registry --workspace=@deribfy/execution-contract --workspace=@deribfy/fidelity --workspace=@deribfy/router",
    "verifier": "node scripts/verifier-comme-le-ci.mjs",
    "gate:app-compile": "node docs/elite-protocol/evidence/gate-app-compile.mjs",
    "gate:app-web": "node docs/elite-protocol/evidence/gate-app-web.mjs",
    "gate:app-web-rendu": "vitest run --config docs/elite-protocol/evidence/observation/obs-web.config.ts corpus-web",
    "gate:app-web-build": "node docs/elite-protocol/evidence/gate-app-web-build.mjs",
    "gate:composition": "node --experimental-strip-types docs/elite-protocol/evidence/gate-composition.mjs",
    "gate:fidelite": "node --experimental-strip-types docs/elite-protocol/evidence/gate-fidelite.mjs",
    "gate:invariants": "node --experimental-strip-types docs/elite-protocol/evidence/harnais-invariants.mjs",
    "gate:navigation": "node --experimental-strip-types docs/elite-protocol/evidence/gate-navigation.mjs",
    "gate:controles": "vitest run --config docs/elite-protocol/evidence/observation/obs.config.ts controles-fantomes",
    "gate:bench-parse": "for f in benchmarks/air-emission/*.mjs; do node --check \"$f\" || exit 1; done && echo 'scripts du banc : syntaxe OK'",
    "gate:e33-remote": "node --experimental-strip-types docs/elite-protocol/evidence/observation/e33-emettre-fixture.mjs && vitest run --config docs/elite-protocol/evidence/observation/obs.config.ts e33-source-reseau",
    "gate:app-rendu": "vitest run --config docs/elite-protocol/evidence/observation/obs.config.ts corpus-rendu",
    "gate:session": "vitest run --config docs/elite-protocol/evidence/observation/obs.config.ts session",
    "packages:test": "npm run test --workspace=@deribfy/air-schema --workspace=@deribfy/capability-registry --workspace=@deribfy/golden-corpus --workspace=@deribfy/design-tokens --workspace=@deribfy/primitives --workspace=@deribfy/blocks --workspace=@deribfy/compiler --workspace=@deribfy/provisioner --workspace=@deribfy/sandbox --workspace=@deribfy/oracle --workspace=@deribfy/workflow --workspace=@deribfy/slots --workspace=@deribfy/repair --workspace=@deribfy/provider-registry --workspace=@deribfy/execution-contract --workspace=@deribfy/fidelity --workspace=@deribfy/router"
  }
}
