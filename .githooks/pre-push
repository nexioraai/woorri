#!/usr/bin/env bash
# ════════════════════════════════════════════════════════════════════
#  AVANT DE POUSSER — EXÉCUTER LE CI, PAS SON SOUVENIR.
# ════════════════════════════════════════════════════════════════════
#
# ── POURQUOI CE HOOK EXISTE.
#
# Le 2026-10-04, un commit a été poussé sur `main` en faisant passer `pkg_lint`
# et `pkg_test` de vert à rouge. La vérification locale avait porté sur 3
# packages sur 11 : un sous-ensemble choisi de mémoire, qui ne pouvait pas
# contredire son auteur.
#
# Le correctif de fond est `npm run verifier`, qui LIT `.github/workflows/ci.yml`
# et exécute ses étapes. Mais un outil qu'il faut penser à lancer ne protège que
# les jours où on y pense — et ce jour-là, précisément, on n'y a pas pensé. D'où
# ce hook : il le lance à la seule seconde qui compte, celle où le code part.
#
# ── IL EST CONTOURNABLE, ET C'EST ASSUMÉ.
#
# `git push --no-verify` passe outre. On ne cherche pas à l'empêcher : un hook
# qu'on ne peut pas contourner dans une urgence devient un hook qu'on désinstalle
# — et on perd tout. Ce qu'on vise est plus modeste et plus solide : que PASSER
# OUTRE SOIT UN GESTE CONSCIENT, pas un oubli.
#
# ── IL NE JUGE PAS CE QUI EST ROUGE PAR DÉCISION.
#
# `app_fidelite` est rouge sur `main` par arbitrage (D-134/D-125) et ne doit
# jamais être « corrigée ». `verifier` lit cette dette depuis le gate lui-même et
# ne la compte pas comme une régression — sinon ce hook serait rouge en
# permanence, donc ignoré, donc inutile.
#
# ── INSTALLATION (une fois par clone)
#
#     git config core.hooksPath .githooks
#
# Le hook vit DANS le dépôt, à l'inverse de `.git/hooks/` qui n'est pas versionné
# et disparaît au clone suivant.

set -u

racine="$(git rev-parse --show-toplevel)"
cd "$racine" || exit 1

echo "── pre-push : vérification dérivée de .github/workflows/ci.yml"
echo "   (contourner si nécessaire : git push --no-verify)"
echo

# ── CE CROCHET NE VÉRIFIE RIEN LUI-MÊME, ET C'EST LA CORRECTION DE FOND.
#
# MESURÉ le 2026-10-12 : git ouvre la connexion SSH AVANT de lancer ce
# crochet, puis la laisse inactive pendant qu'il tourne. Le message
# « Connection to github.com closed by remote host » apparaît AU MILIEU de la
# sortie de la chaîne. Donc tout crochet qui dure plus de quelques minutes
# casse le push, quel que soit son contenu : 9,5 min puis 6,4 min ont échoué
# de la même façon. Optimiser la chaîne ne pouvait pas régler ça.
#
# La vérification sort donc de la fenêtre de connexion : `npm run verifier`
# la fait AVANT le push et laisse une marque. Ici, on LIT la marque.
#
# LA PROTECTION EST IDENTIQUE : on ne peut pas pousser du code non vérifié.
# Ce qui change, c'est QUAND la chaîne tourne — pas SI elle tourne.
#
# La marque est l'ARBRE des fichiers, pas le commit : vérifier puis committer,
# ou committer puis vérifier, donne le même arbre. Prendre le commit aurait
# refusé le déroulement normal.
gitdir="$(git rev-parse --git-dir)"
marque="$gitdir/verification-verte"

if [ ! -f "$marque" ]; then
  echo "────────────────────────────────────────────────────────────────"
  echo " PUSH INTERROMPU — aucune vérification enregistrée."
  echo
  echo " Lancer :  npm run verifier"
  echo " puis repousser. La chaîne ne peut PAS tourner dans ce crochet :"
  echo " GitHub ferme la connexion pendant qu'elle tourne (mesuré)."
  echo "────────────────────────────────────────────────────────────────"
  exit 1
fi

# L'arbre du travail courant, calculé sur un index TEMPORAIRE — toucher
# l'index réel modifierait ce qui est préparé pour le prochain commit.
idx="$(mktemp -t air-prepush-index)"
if ! GIT_INDEX_FILE="$idx" git read-tree HEAD >/dev/null 2>&1 \
  || ! GIT_INDEX_FILE="$idx" git add -A >/dev/null 2>&1; then
  rm -f "$idx"
  echo "── pre-push : impossible de calculer l'arbre du travail. Refus."
  exit 1
fi
actuel="$(GIT_INDEX_FILE="$idx" git write-tree 2>/dev/null)"
rm -f "$idx"
verifie="$(cat "$marque" 2>/dev/null | tr -d '[:space:]')"

if [ -n "$actuel" ] && [ "$actuel" = "$verifie" ]; then
  echo "── pre-push : vérification à jour ($actuel) — le push continue."
  exit 0
fi

echo "────────────────────────────────────────────────────────────────"
echo " PUSH INTERROMPU — le code a changé depuis la dernière"
echo " vérification verte."
echo
echo "   vérifié : ${verifie:-aucun}"
echo "   actuel  : ${actuel:-inconnu}"
echo
echo " Lancer :  npm run verifier"
echo " puis repousser."
echo
echo " Passer outre sciemment :     git push --no-verify"
echo "────────────────────────────────────────────────────────────────"
exit 1
